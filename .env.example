NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://commerce:commerce_dev@localhost:5432/commerce
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_SECONDS=900
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Empty REDIS_URL uses bounded in-process sessions (single instance only).
REDIS_URL=redis://localhost:6379
CHAT_TTL_SECONDS=1800
CHAT_MAX_SESSIONS=1000
CORS_ORIGIN=http://localhost:5173
# Used only by npm run seed; never commits credentials or overwrites an existing user.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
